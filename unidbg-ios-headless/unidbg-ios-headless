#!/bin/sh
# Global entrypoint for the reusable iOS headless MCP launcher.
# Usage: unidbg-ios-headless [options] <ipa>
# Defaults to HTTP transport; uses $UNIDBG_IPA when no IPA is given.
set -e

SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  LINK="$(readlink "$SCRIPT")"
  case "$LINK" in
    /*) SCRIPT="$LINK" ;;
    *) SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
  esac
done
REPO="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

JAR="$(ls -t "$REPO"/unidbg-ios-headless/target/unidbg-ios-headless-*.jar 2>/dev/null | head -1)"

if [ -z "$JAR" ]; then
  echo "unidbg-ios-headless JAR not found." >&2
  echo "Run:" >&2
  echo "  cd $REPO" >&2
  echo "  ./mvnw -pl unidbg-ios-headless -am package -DskipTests" >&2
  exit 1
fi

HAS_TRANSPORT=0
for arg in "$@"; do
  case "$arg" in
    --transport|--transport=*) HAS_TRANSPORT=1; break ;;
  esac
done

if [ "$HAS_TRANSPORT" -eq 0 ]; then
  set -- --transport http "$@"
fi

# No IPA on the command line: fall back to the environment so caller
# configs (e.g. mcp.json) never need to name an IPA file.
HAS_IPA=0
SKIP_NEXT=0
for arg in "$@"; do
  if [ "$SKIP_NEXT" -eq 1 ]; then
    SKIP_NEXT=0
    continue
  fi
  case "$arg" in
    --ipa|--rootfs|--backend|--transport|--mcp-port|--break-offset)
      SKIP_NEXT=1
      case "$arg" in
        --ipa) HAS_IPA=1 ;;
      esac
      continue
      ;;
    --ipa=*) HAS_IPA=1; continue ;;
    --*) continue ;;
    *) HAS_IPA=1; break ;;
  esac
done

if [ "$HAS_IPA" -eq 0 ] && [ -n "$UNIDBG_IPA" ]; then
  set -- "$@" "$UNIDBG_IPA"
fi

exec java -jar "$JAR" "$@"
